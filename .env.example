# 디스코드 개발자 포털 → Bot → Reset Token 으로 받은 토큰
DISCORD_TOKEN=

# (선택) 개발 중에는 서버 ID를 넣으면 명령어가 그 서버에 즉시 반영됩니다.
# 비워 두면 전역 등록 (반영까지 최대 1시간)
DEV_GUILD_ID=

# (선택) DB 파일 위치. 기본값: data/bot.db
DB_PATH=

# (선택) 로스트아크 공식 Open API 키 — 아이템 레벨 자동 갱신용
# https://developer-lostark.game.onstove.com 에서 로그인 → CLIENTS 에서 발급
LOSTARK_API_KEY=

# (선택) 구글 시트 내보내기 - README 참고
# 서비스 계정 키(JSON) 파일 경로, 내보낼 스프레드시트 ID (주소의 /d/ 와 /edit 사이 값)
GOOGLE_CREDENTIALS_FILE=
GOOGLE_SHEET_ID=
# 30분마다 자동 내보내기를 끄려면 0
GOOGLE_AUTO_EXPORT=1
